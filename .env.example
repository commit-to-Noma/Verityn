# Copy to .env for local dev (never commit .env). On Vercel, set these
# as project environment variables instead; the serverless function
# only reads exported env, never a file.
#
# The one secret. Server-side only: the frontend bundle must never see
# it. Without it the backend keeps its deterministic fake providers.
MODEL_API_KEY=

# Local Flask port (`python backend/app.py`). Pair with the frontend:
# VERITYN_API=http://127.0.0.1:$VERITYN_PORT when it differs from the
# Vite proxy default below.
VERITYN_PORT=5000

# Backend origin for the Vite dev/preview /api proxy.
# Default when unset: http://127.0.0.1:5001
VERITYN_API=http://127.0.0.1:5001

# Opt-in live SAM 3.1 spike only; nothing in the learning journey
# reads it. Leave unset unless running scripts/sam_spike.py.
VERITYN_SAM_ENABLED=

# Public shareable URL baked into the frontend at build time.
VITE_PUBLIC_URL=

# NEVER set live: test-only provider-failure switch honored only by
# `python backend/app.py`, never by the Vercel function.
# VERITYN_COACH_FAIL=1
